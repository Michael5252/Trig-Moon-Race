rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /scores/{id} {
   allow read: if true;
   allow create: if request.resource.data.keys().hasOnly(['name','correct','timeMs','xp','completedAt'])
    && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
    && request.resource.data.correct is int && request.resource.data.correct >= 0 && request.resource.data.correct <= 30
    && request.resource.data.timeMs is int && request.resource.data.timeMs >= 1000 && request.resource.data.timeMs <= 3600000
    && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 10000;
   allow update, delete: if false;
  }
 }
}